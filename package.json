{
  "name": "sei-pro-prf",
  "private": true,
  "description": "Dev tooling for SEI Pro PRF extension",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "pretest": "node scripts/build.mjs",
    "test": "vitest run",
    "test:atividades:smoke": "vitest run tests/features/atividades/smoke.test.js tests/features/atividades/view.test.js tests/features/atividades/call.test.js",
    "test:watch": "vitest",
    "loop:map": "node scripts/engineering-loop-map.mjs",
    "loop:map:check": "node scripts/engineering-loop-map.mjs --check",
    "loop:next": "node scripts/engineering-loop-next.mjs",
    "loop:next:check": "node scripts/engineering-loop-next.mjs --check-board"
  },
  "//build": "esbuild bundla entries ESM (core-stack, features, login/db) e copia legados verbatim para dist/. Fonte da verdade: src/. Ver DEVELOPMENT.md.",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "vitest": "^3.2.4"
  }
}
