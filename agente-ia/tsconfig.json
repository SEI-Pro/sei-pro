{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["chrome", "node"],
    "baseUrl": ".",
    "paths": {
      "@agente/*": ["./src/*"],
      "@nucleo/*": ["../sei-nucleo/src/*"],
      "@tarjar/*": ["../ferramentas-pdf/src/lib/*"],
      "@/*": ["../ferramentas-pdf/src/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "evals/**/*.ts"]
}
